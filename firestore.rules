rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All writes happen exclusively through server-side Route Handlers using
    // the Firebase Admin SDK, which bypasses these rules entirely. Clients
    // therefore never get direct write access to anything.

    // Hotspots/puzzles carry a `setId` (an eventId or templateId) so one
    // event's or template's stations don't leak into another's - but the
    // read rule itself is the same open rule for all of them.
    match /hotspots/{hotspotId} {
      allow read: if true;
      allow write: if false;
    }

    match /puzzles/{puzzleId} {
      allow read: if true;
      allow write: if false;
    }

    // Teacher-added extra floors/maps (setId-scoped like hotspots/puzzles).
    match /floors/{floorId} {
      allow read: if true;
      allow write: if false;
    }

    // Never readable by clients: this is where correct answers live.
    match /puzzleAnswers/{puzzleId} {
      allow read, write: if false;
    }

    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if false;

      match /groups/{groupId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
