# Firebase Web-App-Konfiguration (Firebase Console -> Projekteinstellungen -> "Meine Apps" -> Web-App)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK Service-Account-Key als EINE Zeile JSON
# (Firebase Console -> Projekteinstellungen -> Dienstkonten -> "Neuen privaten Schlüssel generieren")
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...", ...}'

# Lehrkraft-Bereich (Anmeldung läuft über Firebase Authentication)
# Firebase Console -> Authentication -> Sign-in method -> "E-Mail/Passwort" aktivieren.

# Vercel Blob Storage für Rätsel-Bilder
# (Vercel Dashboard -> Projekt -> Storage -> Blob -> Store erstellen -> ".env.local" Tab)
BLOB_READ_WRITE_TOKEN=

# Google Maps JavaScript API Key für Live-GPS-Ebenen
# (Google Cloud Console -> APIs & Dienste -> Anmeldedaten -> API-Schlüssel erstellen,
# "Maps JavaScript API" aktivieren, Schlüssel per HTTP-Referrer auf eure Domain einschränken)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
